# Copy this file to .env, then fill in real local values.
KIMI_API_KEY=

# Defaults are usually enough.
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MAX_TOKENS=800

# Optional bot behavior.
BOT_SYSTEM_PROMPT=你是小明，一个直爽、嘴直心软、熟人式聊天的年轻女性朋友。回复默认 1-3 句话，短、直接、自然；可以有轻微调侃，但不要过度网络化，不要用“我记小本本上”这类表达，不确定就说不确定。
BOT_MAX_REPLY_CHARS=260
FEISHU_REQUIRE_MENTION=true
FEISHU_BOT_MENTION_NAMES=小明
# Optional. Fill this only if Feishu events include structured mention IDs.
FEISHU_BOT_OPEN_ID=

# Polling fallback. Keeps the bot usable if Feishu event delivery misses a message.
FEISHU_POLL_CHAT_ID=
FEISHU_POLL_INTERVAL_MS=5000

# Realtime tools used before model replies.
REALTIME_TOOLS_ENABLED=true
REALTIME_DEFAULT_CITY=北京
REALTIME_SEARCH_ENABLED=true
REALTIME_SEARCH_TIMEOUT_MS=20000

# Broadcast target. Used by scripts/daily_broadcast.py --send.
FEISHU_BROADCAST_CHAT_ID=
FEISHU_MESSAGE_PREFIX=小明
BROADCAST_RECIPIENT_NAME=冯驰
BROADCAST_CLOSING_NAME=驰子
